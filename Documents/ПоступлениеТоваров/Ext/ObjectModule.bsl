Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
    // Говорим платформе, что набор движений по этому регистру нужно записать в БД
    Движения.ОстаткиМатериалов.Записывать = Истина;
    
    // Проходим по всем строкам табличной части "Товары"
    Для Каждого СтрокаТЧ Из Товары Цикл
        
        // Пропускаем пустые строки (на всякий случай)
        Если СтрокаТЧ.Количество <= 0 Тогда
            Продолжить;
        КонецЕсли;
        
        // Создаём новое движение в наборе
        Движение = Движения.ОстаткиМатериалов.Добавить();
        
        // Вид движения — Приход (увеличиваем остаток)
        Движение.ВидДвижения  = ВидДвиженияНакопления.Приход;
        
        // Период — дата документа (момент времени, на который делаем движение)
        Движение.Период       = Дата;
        
        // Измерения регистра
        Движение.Склад        = Склад;
        Движение.Номенклатура = СтрокаТЧ.Номенклатура;
        
        // Ресурс регистра
        Движение.Количество   = СтрокаТЧ.Количество;
        
    КонецЦикла;
    
КонецПроцедуры